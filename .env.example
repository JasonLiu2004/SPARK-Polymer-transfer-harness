# Copy to .env and fill in your key. Do not commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Enter the official DeepSeek deployment enabled for your account.
LLM_MODEL=

# Optional for ranking through Paratera. First-time literature extraction uses LLM_* above.
PARATERA_API_KEY=

# Optional: literature search API key
OPENALEX_API_KEY=
